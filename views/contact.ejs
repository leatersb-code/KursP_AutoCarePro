<!-- Контакты -->
<section class="section">
  <div class="container">
    <div class="section-head">
      <h2>Свяжитесь с нами</h2>
      <p>Остались вопросы? Напишите нам — мы ответим в ближайшее время</p>
    </div>

    <div class="hero-grid" style="align-items:start;">
      <!-- Контактная информация -->
      <div>
        <div class="card" style="margin-bottom:16px;">
          <h3>📞 Телефон</h3>
          <p>+996 (555) 123-456</p>
        </div>
        <div class="card" style="margin-bottom:16px;">
          <h3>✉️ Email</h3>
          <p>info@autocarepro.com</p>
        </div>
        <div class="card">
          <h3>📍 Адрес</h3>
          <p>г. Бишкек, ул. Авто, 1</p>
          <p style="margin-top:8px;">Пн–Сб: 9:00 – 19:00</p>
        </div>
      </div>

      <!-- Форма обратной связи -->
      <div>
        <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>
        <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
        <div class="form-card">
          <form action="/contact" method="POST">
            <div class="form-group">
              <label>Ваше имя *</label>
              <input type="text" name="name" class="form-control" required>
            </div>
            <div class="form-group">
              <label>Email *</label>
              <input type="email" name="email" class="form-control" placeholder="you@example.com" required>
            </div>
            <div class="form-group">
              <label>Сообщение *</label>
              <textarea name="message" class="form-control" required></textarea>
            </div>
            <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center;">Отправить сообщение</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>
